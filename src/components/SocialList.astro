---
const socialLinks: {
	friendlyName: string;
	link: string;
}[] = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/ohall",
	},
	{
		friendlyName: "LinkedIn",
		link: "https://www.linkedin.com/in/oakleyhall/",
	},
	{
		friendlyName: "Twitter",
		link: "https://twitter.com/_ohall",
	},
	{
		friendlyName: "Medium",
		link: "https://medium.com/@oakley349",
	},
];
---

<nav aria-label="Social links" class="border-t border-border/60 pt-6">
	<ul class="space-y-1.5">
		{socialLinks.map(({ friendlyName, link }) => (
			<li>
				<a
					href={link}
					target="_blank"
					rel="noreferrer"
					class="social-link group"
				>
					<span
						aria-hidden="true"
						class="w-3 font-mono text-xs text-text-subtle transition-colors group-hover:text-accent"
						>↗</span
					>
					<span>{friendlyName}</span>
				</a>
			</li>
		))}
	</ul>
</nav>
