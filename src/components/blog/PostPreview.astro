---
import type { CollectionEntry } from "astro:content";
import { getPostSortDate } from "@/data/post";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "../FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
const postDate = getPostSortDate(post);
---

<FormattedDate class="post-date min-w-[120px]" date={postDate} />
<Tag>
	{post.data.draft && <span class="font-mono text-xs text-quote">(Draft) </span>}
	<a class="post-title" data-astro-prefetch href={`/posts/${post.slug}/`}>
		{post.data.title}
	</a>
</Tag>
{withDesc && <q class="line-clamp-3 text-[0.9375rem] italic text-text-muted">{post.data.description}</q>}
